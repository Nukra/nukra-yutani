{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "@LOGOPATH@",
    "type": "file",
    "color": { "1": "@ANSIFG@" },
    "padding": { "top": 1, "right": 4 }
  },
  "display": { "separator": " ......... ", "color": { "keys": "@ANSIHOT@", "title": "@ANSIFG@" } },
  "modules": [
    { "type": "custom", "format": "\u001b[@ANSIDIM@m****************************************" },
    { "type": "custom", "format": "\u001b[@ANSIHOT@m  PERSONAL-TERMINAL-ACCESS-INTERFACE" },
    { "type": "custom", "format": "\u001b[@ANSIDIM@m****************************************" },
    "break",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "de", "key": "DE" },
    { "type": "wm", "key": "SESSION" },
    { "type": "shell", "key": "SHELL" },
    { "type": "terminal", "key": "TERM" },
    { "type": "terminalfont", "key": "FONT" },
    { "type": "custom", "format": "THEME ...... PTAI-@NAME@" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "STORAGE" },
    { "type": "uptime", "key": "UPTIME" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
