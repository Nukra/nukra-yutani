/* PTAI @NAME@ — GNOME Shell theme. Generated by ptai-theme; edit src/gnome-shell.css.in instead. */
@import url("resource:///org/gnome/shell/theme/gnome-shell.css");

/* GNOME 47+ resolves toggle fills, sliders, check marks and selection from the
   accent colour rather than from the widget classes, so overriding the classes
   alone leaves stock teal behind. Redefining the accent at the top of the tree
   recolours every accent-driven widget at once, including ones whose node names
   change between shell releases. */
stage {
  font-family: "Share Tech Mono", monospace;
  font-size: 11pt;
  color: @FG@;
  text-shadow: 0 0 6px @GLOW@;
  -st-accent-color: @FG@;
  -st-accent-fg-color: @BG@;
}

/* phosphor glow — St renders one text-shadow per actor, so it is applied at
   the widget classes that carry text rather than inherited from stage. */
#panel .panel-button,
.popup-menu-item,
.message-title, .message-body, .message-content,
.search-entry, .list-search-result,
.overview-tile, .window-caption,
.calendar, .calendar-month-label,
.screen-shield-clock-time, .screen-shield-clock-date,
.login-dialog-username, .login-dialog-prompt-label,
.modal-dialog, .osd-window, .switcher-list,
.quick-toggle, .quick-settings-system-item {
  text-shadow: 0 0 6px @GLOW@;
}
#panel .clock-display .clock,
.message-title,
.login-dialog-username,
.screen-shield-clock-time {
  text-shadow: 0 0 10px @GLOW@;
}
/* inverted (selected) states drop the glow — it smears dark text on bright fill */
#panel .panel-button:hover, #panel .panel-button:checked, #panel .panel-button:active,
.popup-menu-item:hover, .popup-menu-item:focus, .popup-menu-item.selected,
.list-search-result:hover, .list-search-result:selected,
.button:hover, .modal-dialog-linked-button:hover,
.switcher-list .item-box:selected,
.login-dialog-user-list-item:hover, .login-dialog-user-list-item:focus {
  text-shadow: none;
}

/* ---- top bar ---- */
#panel {
  background-color: rgba(0,0,0,0.84);
  border-bottom: 1px solid @DIM@;
  height: 52px;
}
#panel .panel-button {
  color: @FG@;
  border-radius: 0;
  -natural-hpadding: 10px;
  -minimum-hpadding: 6px;
}
#panel .panel-button StIcon { icon-shadow: 0 0 6px @GLOW@; color: @FG@; }
#panel .panel-button:hover,
#panel .panel-button:active,
#panel .panel-button:overview,
#panel .panel-button:focus,
#panel .panel-button:checked {
  background-color: @FG@;
  color: @BG@;
  box-shadow: none;
  border-radius: 0;
}
#panel .panel-button:hover StIcon,
#panel .panel-button:checked StIcon { color: @BG@; }
#panelActivities { letter-spacing: 0.12em; }
#panel .clock-display .clock { color: @HOT@; letter-spacing: 0.08em; }
#panel .panel-status-indicators-box StIcon,
#panel .panel-status-menu-box StIcon { color: @FG@; }

/* ---- top bar furniture (ptai-crt extension) ---- */
.ptai-wordmark {
  -minimum-hpadding: 8px;
  padding: 0 12px 0 10px;
  spacing: 8px;
  border-right: 1px solid @DIM@;
}
.ptai-wordmark-org {
  font-family: 'Silkscreen', monospace;
  font-size: 11px;
  letter-spacing: 0.22em;
  color: @HOT@;
  text-shadow: 0 0 8px @GLOW@;
}
.ptai-wordmark-sub {
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.18em;
  color: @BG@;
  background-color: @FG@;
  padding: 1px 5px;
}
.ptai-readout-box {
  padding: 0 10px;
  border-left: 1px solid @DIM@;
}
.ptai-readout {
  font-family: 'Share Tech Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.12em;
  color: @ROLE_META@;
}
/* The readout/indicator group is the sticky end of the bar: it keeps its full
   padding so the gauge cluster to its left is what gives up width first. */
.ptai-readout-box { -natural-hpadding: 10px; -minimum-hpadding: 10px; }
.ptai-hazard { color: @DIM@; }

/* live gauges: label, value, sparkline. The bar is taller than stock GNOME,
   so the furniture gets room to breathe without crowding the clock. */
/* Gauges yield before the wordmark and the readout: they carry the smallest
   minimum padding on the bar, so a crowded panel compresses the cluster rather
   than clipping either end group. */
.ptai-gauge {
  border-left: 1px solid @DIM@;
  -natural-hpadding: 8px;
  -minimum-hpadding: 3px;
}
.ptai-gauge-box { spacing: 6px; }
.ptai-gauge-label {
  font-family: 'Silkscreen', monospace;
  font-size: 11px;
  letter-spacing: 0.14em;
  color: @ROLE_META@;
}
.ptai-gauge-value {
  font-family: 'Share Tech Mono', monospace;
  font-size: 15px;
  letter-spacing: 0.06em;
  color: @FG@;
}
.ptai-gauge-spark { width: 42px; height: 22px; color: @FG@; }
.ptai-gauge:hover .ptai-gauge-label,
.ptai-gauge:checked .ptai-gauge-label,
.ptai-gauge:hover .ptai-gauge-value,
.ptai-gauge:checked .ptai-gauge-value,
.ptai-gauge:hover .ptai-gauge-spark,
.ptai-gauge:checked .ptai-gauge-spark { color: @BG@; }
.ptai-detail-row { spacing: 24px; min-width: 260px; }
.ptai-detail-key {
  font-family: 'Share Tech Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.16em;
  color: @ROLE_META@;
}
.ptai-detail-val {
  font-family: 'Share Tech Mono', monospace;
  font-size: 12px;
  color: @HOT@;
}

/* ---- popups, menus, calendar ---- */
.popup-menu, .quick-settings, .candidate-popup-boxpointer,
.datemenu-popover, .message-list {
  color: @FG@;
}
.popup-menu-boxpointer, .popup-menu .popup-menu-content,
.quick-settings, .datemenu-popover,
.popup-menu-content, .candidate-popup-content {
  background-color: rgba(0,0,0,0.92);
  border: 1px solid @DIM@;
  border-radius: 0;
  box-shadow: none;
}
.popup-menu-item { border-radius: 0; color: @FG@; }
.popup-menu-item:hover, .popup-menu-item:focus, .popup-menu-item.selected,
.popup-menu-item:active {
  background-color: @FG@;
  color: @BG@;
}
.popup-menu-item:checked { background-color: @DIM@; color: @HOT@; }
.popup-separator-menu-item .popup-separator-menu-item-separator,
.popup-separator-menu-item StWidget { background-color: @DIM@; }
.popup-sub-menu { background-color: rgba(0,0,0,0.95); }

/* Quick settings. GNOME's own sheet paints these from the accent colour and
   sets the pill radius on inner children, so the radius resets and the checked
   fills are forced — matching only the outer actor leaves teal pills behind. */
.quick-settings {
  padding: 10px;
}
.quick-toggle, .quick-slider, .quick-menu-toggle, .quick-settings-system-item,
.quick-toggle-button, .quick-settings-subtitle-container,
.quick-menu-toggle .quick-toggle, .quick-menu-toggle .quick-toggle-arrow,
.quick-toggle > StBoxLayout, .quick-menu-toggle > StBoxLayout {
  border-radius: 0 !important;
}
.quick-toggle, .quick-slider, .quick-settings-system-item, .quick-toggle-button,
.quick-menu-toggle .quick-toggle, .quick-menu-toggle .quick-toggle-arrow {
  background-color: rgba(0,0,0,0.6) !important;
  border: 1px solid @DIM@;
  color: @FG@;
  font-family: 'Share Tech Mono', monospace;
  letter-spacing: 0.06em;
}
.quick-menu-toggle .quick-toggle { border-right-width: 0; }
.quick-toggle:hover, .quick-toggle-button:hover, .quick-slider:hover,
.quick-settings-system-item:hover, .quick-menu-toggle .quick-toggle:hover,
.quick-menu-toggle .quick-toggle-arrow:hover {
  background-color: @DIM@ !important;
  border-color: @FG@;
  color: @HOT@;
}
.quick-toggle:checked, .quick-toggle-button:checked,
.quick-menu-toggle .quick-toggle:checked,
.quick-menu-toggle .quick-toggle-arrow:checked,
.quick-toggle:active, .quick-toggle-button:active {
  background-color: @FG@ !important;
  border-color: @FG@;
  color: @BG@ !important;
}
.quick-toggle:checked StIcon, .quick-toggle-button:checked StIcon,
.quick-menu-toggle .quick-toggle:checked StIcon,
.quick-menu-toggle .quick-toggle-arrow:checked StIcon,
.quick-toggle:checked StLabel, .quick-menu-toggle .quick-toggle:checked StLabel {
  color: @BG@ !important;
}
.quick-toggle .title, .quick-menu-toggle .title { color: inherit; }
.quick-toggle .subtitle, .quick-menu-toggle .subtitle {
  color: @ROLE_META@;
  font-size: 0.85em;
  letter-spacing: 0.1em;
}
.quick-toggle:checked .subtitle, .quick-menu-toggle .quick-toggle:checked .subtitle {
  color: @BG@ !important;
}

/* the round icon buttons across the top of the popup */
.icon-button, .message-list-clear-button, .button-round,
.quick-settings-system-item .icon-button,
.quick-settings-system-item > StBoxLayout > .icon-button {
  border-radius: 0 !important;
  border: 1px solid @DIM@;
  color: @FG@;
  background-color: rgba(0,0,0,0.5) !important;
  box-shadow: none;
}
.icon-button:hover, .button-round:hover,
.quick-settings-system-item .icon-button:hover {
  background-color: @FG@ !important;
  border-color: @FG@;
  color: @BG@;
}
.icon-button:hover StIcon, .button-round:hover StIcon { color: @BG@; }
.icon-button:checked, .button-round:checked {
  background-color: @FG@ !important;
  color: @BG@;
}

.slider {
  color: @FG@;
  -barlevel-height: 5px;
  -barlevel-radius: 0;
  -barlevel-background-color: rgba(0,0,0,0.6);
  -barlevel-border-color: @DIM@;
  -barlevel-border-width: 1px;
  -barlevel-active-background-color: @FG@;
  -barlevel-active-border-color: @FG@;
  -slider-handle-radius: 0;
  -slider-height: 5px;
  -slider-handle-border-width: 1px;
  -slider-handle-border-color: @BG@;
  -slider-background-color: rgba(0,0,0,0.6);
  -slider-active-background-color: @FG@;
  -slider-border-color: @DIM@;
  -slider-active-border-color: @FG@;
}
.quick-slider .slider { color: @HOT@; }

/* Node names inside quick settings drift between shell releases (the pill fill
   has moved between the button, an inner StBoxLayout and a dedicated label node
   across 45-49), so the whole subtree is squared off and de-accented by
   descendant selector rather than by naming each part. */
.quick-settings StButton,
.quick-settings StBoxLayout,
.quick-settings StIcon,
.quick-settings StLabel,
.quick-settings StWidget,
.quick-settings-grid StButton,
.quick-settings-grid StBoxLayout {
  border-radius: 0 !important;
}
.quick-settings StButton {
  background-color: rgba(0,0,0,0.6) !important;
  border: 1px solid @DIM@;
  color: @FG@;
}
.quick-settings StButton:hover {
  background-color: @DIM@ !important;
  border-color: @FG@;
  color: @HOT@;
}
.quick-settings StButton:checked,
.quick-settings StButton:active {
  background-color: @FG@ !important;
  border-color: @FG@;
  color: @BG@ !important;
}
.quick-settings StButton:checked StIcon,
.quick-settings StButton:checked StLabel,
.quick-settings StButton:active StIcon,
.quick-settings StButton:active StLabel {
  color: @BG@ !important;
}
/* inner layout boxes must stay transparent or they paint over the button fill */
.quick-settings StButton StBoxLayout,
.quick-settings StButton StIcon,
.quick-settings StButton StLabel {
  background-color: transparent !important;
}

/* ---- calendar ---- */
.calendar { color: @FG@; }
.calendar-today, .calendar-day-base:selected {
  background-color: @FG@; color: @BG@; border-radius: 0; border: none;
}
.calendar-day-base:hover { background-color: @DIM@; color: @HOT@; border-radius: 0; }
.calendar-day-heading, .calendar-month-label { color: @ROLE_META@; }
.calendar-month-label { letter-spacing: 0.14em; }

/* ---- notifications ---- */
.message, .notification-banner, .message-list-section-list .message {
  background-color: rgba(0,0,0,0.92);
  border: 1px solid @DIM@;
  border-radius: 0;
  color: @FG@;
  box-shadow: none;
}
.message:hover, .notification-banner:hover { border-color: @FG@; }
.message-title, .notification-banner .message-title { color: @HOT@; letter-spacing: 0.08em; }
.message-content, .message-body { color: @FG@; }
.message-secondary-bar { color: @ROLE_META@; }

/* ---- overview / search / dash ---- */
#overview { color: @FG@; }
.search-entry {
  background-color: rgba(0,0,0,0.7);
  border: 1px solid @FG@;
  border-radius: 0;
  color: @FG@;
  caret-color: @HOT@;
  selection-background-color: @FG@;
  selected-color: @BG@;
}
.search-entry:focus { border: 1px solid @HOT@; box-shadow: none; }
.search-entry StIcon { color: @ROLE_META@; }
.search-section-content, .list-search-result {
  background-color: transparent; border-radius: 0; color: @FG@;
}
.list-search-result:hover, .list-search-result:focus,
.list-search-result:selected { background-color: @FG@; color: @BG@; }
.search-provider-icon:hover { background-color: @DIM@; border-radius: 0; }

#dash, .dash-background {
  background-color: rgba(0,0,0,0.82);
  border: 1px solid @DIM@;
  border-radius: 0;
  padding: 4px;
}
.overview-tile, .app-well-app .overview-icon, .show-apps .overview-icon {
  border-radius: 0;
  color: @FG@;
}
.overview-tile:hover, .overview-tile:focus, .overview-tile:selected,
.app-well-app:hover .overview-icon { background-color: @DIM@; color: @HOT@; }
.app-folder-dialog { background-color: rgba(0,0,0,0.94); border: 1px solid @DIM@; border-radius: 0; }
.page-indicator-icon { background-color: @DIM@; }
.workspace-thumbnail, .workspace-thumbnails .workspace-thumbnail {
  border: 1px solid @DIM@; border-radius: 0;
}
.workspace-thumbnail:active, .workspace-thumbnails .active { border-color: @FG@; }
.window-clone-border, .window-picker .window-clone-border { border: 1px solid @DIM@; border-radius: 0; }
.window-caption { background-color: rgba(0,0,0,0.9); color: @FG@; border: 1px solid @DIM@; border-radius: 0; }

/* ---- OSD, modals, dialogs ---- */
.osd-window, .modal-dialog, .end-session-dialog, .headline {
  background-color: rgba(0,0,0,0.94);
  border: 1px solid @DIM@;
  border-radius: 0;
  color: @FG@;
}
.modal-dialog-linked-button, .button {
  background-color: transparent;
  border: 1px solid @DIM@;
  border-radius: 0;
  color: @FG@;
  letter-spacing: 0.1em;
}
.modal-dialog-linked-button:hover, .button:hover,
.modal-dialog-linked-button:focus, .button:focus {
  background-color: @FG@; color: @BG@; border-color: @FG@;
}
.modal-dialog-linked-button:default { color: @HOT@; border-color: @FG@; }

/* ---- lock screen / GDM greeter ---- */
#lockDialogGroup, .login-dialog, .unlock-dialog {
  background-color: @BG@;
  color: @FG@;
}
.login-dialog-banner, .unlock-dialog-clock, .screen-shield-clock,
.screen-shield-clock-time, .screen-shield-clock-date {
  color: @FG@;
  font-family: "Share Tech Mono", monospace;
  text-shadow: 0 0 10px @GLOW@;
}
.screen-shield-clock-time { font-weight: normal; letter-spacing: 0.06em; }
.login-dialog-user-list, .login-dialog-user-list-item { color: @FG@; }
.login-dialog-user-list:expanded .login-dialog-user-list-item:selected,
.login-dialog-user-list-item:focus, .login-dialog-user-list-item:hover {
  background-color: @FG@; color: @BG@; border-radius: 0;
}
.login-dialog-prompt-label { color: @ROLE_META@; letter-spacing: 0.14em; }
.login-dialog-username, .user-widget-label { color: @HOT@; letter-spacing: 0.1em; }
.login-dialog .modal-dialog-button-box .button { border-color: @DIM@; }
.login-dialog-prompt-entry, .unlock-dialog-entry, StEntry {
  background-color: rgba(0,0,0,0.65);
  border: 1px solid @FG@;
  border-radius: 0;
  color: @FG@;
  caret-color: @HOT@;
  selection-background-color: @FG@;
  selected-color: @BG@;
}
StEntry:focus { border: 1px solid @HOT@; box-shadow: none; }
.login-dialog-not-listed-label { color: @ROLE_META@; }
.user-icon, .login-dialog-user-list-item .user-widget StIcon { border-radius: 0; color: @FG@; }

/* ---- misc ---- */
.workspace-switcher, .switcher-list, .switcher-list-item-container {
  background-color: rgba(0,0,0,0.92);
  border: 1px solid @DIM@;
  border-radius: 0;
  color: @FG@;
}
.switcher-list .item-box:selected, .switcher-list .item-box:outlined {
  background-color: @FG@; color: @BG@; border-radius: 0;
}
.ripple-box { background-color: @DIM@; }
.screencast-indicator, .screen-sharing-indicator { color: @HOT@; }
